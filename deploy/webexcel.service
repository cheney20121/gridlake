# systemd 服务：cp webexcel.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now webexcel
[Unit]
Description=Web Excel 表格服务（ledger-server）
After=network.target

[Service]
Type=simple
User=webexcel
Group=webexcel
EnvironmentFile=/etc/webexcel/ledger.env
WorkingDirectory=/var/lib/webexcel
ExecStart=/opt/webexcel/bin/ledger-server
# 停止时发 SIGTERM：服务会等进行中的请求完成并把数据写回主文件；不要用 kill -9
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
# 硬内存上限兜底（LEDGER_MEMORY_LIMIT 只约束 DuckDB 缓冲区）：超限时只重启本服务，不会误杀别的进程；亿级数据建议留 16G 以上
# MemoryMax=16G
# 安全加固：只允许写数据目录
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/webexcel
PrivateTmp=true

[Install]
WantedBy=multi-user.target
