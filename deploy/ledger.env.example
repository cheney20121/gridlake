# Gridlake 表格服务配置（systemd 的 EnvironmentFile / docker-compose 的 env_file）
# 修改后重启服务生效：systemctl restart gridlake

# 监听地址：对外提供服务用 0.0.0.0:8787；前面有 nginx 时可只监听本机 127.0.0.1:8787
LEDGER_ADDR=0.0.0.0:8787

# 数据文件（所有数据都在这一个文件里，备份 / 迁移以它为准）
LEDGER_DB=/var/lib/gridlake/ledger.duckdb

# 前端页面目录（安装包里的 web/）；设置后浏览器直接访问 http://服务器:8787/excel
LEDGER_WEB_DIR=/opt/gridlake/web

# DuckDB 内存上限；不设置时自动取机器（容器）内存的 30%（不少于 1GB），启动日志里会写明；超出部分落盘到 数据目录/tmp/spill。
# 注意它不是进程内存的硬上限（排序游标会遵守它，但亿级数据上的精确分位数 / 精确去重等聚合的中间结果会超出（大数据集改用近似版），实测峰值可达 2~3 倍），不要设得太大；off 为使用 DuckDB 默认（内存的 80%）
# LEDGER_MEMORY_LIMIT=8GB

# 同时进行的「大计算」个数（透视、SQL、异常发现、带筛选 / 排序的游标），超出的排队；默认每 2GB 内存上限一个（1~4）
# LEDGER_HEAVY_QUERIES=2
# 大计算排队的最长等待秒数，超时提示「服务繁忙」
# LEDGER_HEAVY_WAIT_SECS=120

# 计算线程数，默认等于 CPU 核数；与其他业务共用服务器时可调小
# LEDGER_THREADS=8

# 每天自动备份的时间（off 关闭），保留份数，备份目录（建议放在另一块磁盘；
# 不在 /var/lib/gridlake 下时，要同时加到 gridlake.service 的 ReadWritePaths）
LEDGER_BACKUP_AT=02:30
LEDGER_BACKUP_KEEP=7
LEDGER_BACKUP_DIR=/var/lib/gridlake/backups

# 备份完成后再上传到对象存储（S3 / MinIO / 阿里云 OSS / 腾讯云 COS 等）；不设置 LEDGER_BACKUP_S3_BUCKET 就不上传。
# 建议为它单独建只管这个桶的密钥（s3:PutObject、GetObject、ListBucket、DeleteObject、AbortMultipartUpload）；secret.key 不会上传，请单独保管
# LEDGER_BACKUP_S3_BUCKET=gridlake-backup
# LEDGER_BACKUP_S3_ACCESS_KEY=
# LEDGER_BACKUP_S3_SECRET_KEY=
# 自建 / 其他云的服务地址（只写主机和端口）；AWS S3 不填，改填区域
# LEDGER_BACKUP_S3_ENDPOINT=https://minio.corp:9000
# LEDGER_BACKUP_S3_REGION=us-east-1
# LEDGER_BACKUP_S3_PREFIX=gridlake-backups/
# 对象存储上保留最近几份（默认 30）；上传后把备份下载回来做恢复演练（多一次下载流量，默认只核对大小）
# LEDGER_BACKUP_S3_KEEP=30
# LEDGER_BACKUP_S3_VERIFY=download

# 单个上传文件上限（MB）
LEDGER_MAX_UPLOAD_MB=1024

# 场景包：auto（默认：库里已有电商台账数据就启用）/ ecommerce / none（都不启用，纯通用表格平台）/ all
# LEDGER_PACKS=auto

# 运维接口 /api/admin/*（状态、手动备份）的令牌；不设置时只允许在服务器本机 curl 访问
# LEDGER_ADMIN_TOKEN=请改成一串随机字符

# 登录校验：local（内置账号，推荐）/ gateway / proxy / off（不校验，任何人可访问）。
# off 只适合本机试用：监听非本机地址（如上面的 0.0.0.0）时服务会拒绝启动，除非明确设置 LEDGER_ALLOW_NO_AUTH=1
#   local  ：用户名 + 密码登录，管理员在首页「自动化 → 账号管理」里建账号
LEDGER_AUTH_MODE=local
# 首次启动时创建的管理员（之后改这两项不影响已有账号）；不设密码则随机生成，只在首次启动的日志里打印一次
# LEDGER_ADMIN_USER=admin
# LEDGER_ADMIN_PASSWORD=请改成强密码
# 登录有效天数，默认 7
# LEDGER_SESSION_DAYS=7
#   gateway：用请求头 x-user-token 向网关的用户信息接口校验（返回 { code: 200, data: { id, username, accountName, superAdmin, tenantAdmin } }）
#   proxy  ：信任反向代理（如 nginx auth_request）注入的 x-auth-user-id / x-auth-user-name（URL 编码）/ x-auth-user-admin 头
# LEDGER_AUTH_MODE=gateway
# LEDGER_AUTH_URL=https://网关地址/api/current_user
# 网关的 HTTPS 证书是内部 CA 签发的：把 CA 根证书（PEM，可含多个）放到服务器上并填路径。程序只内置公共根证书，
# 不配置的话企业内网网关的证书校验失败，所有人无法登录（错误提示里会写明）
# LEDGER_AUTH_CA_FILE=/etc/gridlake/corp-ca.pem
# 校验结果缓存秒数（令牌在网关被吊销后，最多这么久仍然有效），默认 60
# LEDGER_AUTH_CACHE_SECS=60
# 管理员：用户 id 或登录名，逗号分隔（网关标记为超级管理员 / 租户管理员的用户自动是管理员）
# LEDGER_ADMINS=zhangsan,10001
# proxy 模式：可信的反向代理地址，默认只有本机（127.0.0.1、::1）
# LEDGER_TRUSTED_PROXIES=127.0.0.1
# 操作审计保留天数，默认 365
# LEDGER_AUDIT_DAYS=365

# 单点登录（OIDC）：只在 LEDGER_AUTH_MODE=local 下可用，登录页多一个「用 XX 登录」按钮，首次登录自动建账号。
# 身份提供方里登记的回调地址必须与 LEDGER_OIDC_REDIRECT_URL 完全一致；内部 CA 签发的 HTTPS 证书同样用上面的 LEDGER_AUTH_CA_FILE
# LEDGER_OIDC_ISSUER=https://idp.example.com/realms/corp
# LEDGER_OIDC_CLIENT_ID=gridlake
# LEDGER_OIDC_CLIENT_SECRET=
# LEDGER_OIDC_REDIRECT_URL=https://excel.example.com/api/ledger/auth/oidc/callback
# 登录按钮上的名字；属于这个组的人是管理员（每次 SSO 登录时同步）
# LEDGER_OIDC_NAME=公司账号
# LEDGER_OIDC_ADMIN_GROUP=gridlake-admins
# 取登录名 / 姓名 / 组的声明（默认 preferred_username / name / groups）；scope 默认 openid profile email
# LEDGER_OIDC_USERNAME_CLAIM=preferred_username
# LEDGER_OIDC_NAME_CLAIM=name
# LEDGER_OIDC_GROUPS_CLAIM=groups
# LEDGER_OIDC_SCOPES=openid profile email
# 第一次 SSO 登录时自动建账号（默认 1；0 表示只允许已绑定的账号）
# LEDGER_OIDC_AUTO_CREATE=1
# 把身份绑定到同名的已有本地账号（默认不绑，避免身份提供方里的同名用户顶替本地管理员；迁移账号时临时打开）
# LEDGER_OIDC_LINK_BY_USERNAME=0
# 身份提供方地址是明文 http（只在内网、自担风险时用；本机回环地址不需要）
# LEDGER_OIDC_ALLOW_HTTP=0

# 要求所有内置账号开启两步验证（TOTP）：没开启的账号登录后只能设置两步验证；单点登录账号和访问令牌不受限
# LEDGER_REQUIRE_2FA=1

# 允许自己审批自己提交的单据（文件审批、月结）；默认不允许。小团队一个人兼任提交与审批时设为 true
# LEDGER_ALLOW_SELF_APPROVE=false

# 跨域：前端页面由本服务提供（上面的 LEDGER_WEB_DIR）时不需要；前端单独部署时填前端地址，多个用逗号分隔
# LEDGER_CORS=https://excel.example.com

# 「数据连接 → 文件夹」可以收取的目录（多个用逗号分隔），如挂载的共享盘；默认 数据目录/inbox
# LEDGER_INBOX_ROOTS=/var/lib/gridlake/inbox,/mnt/share/抖店导出

# 数据连接里数据库密码的加密密钥（64 位十六进制）；不设置时自动生成 数据目录/secret.key（备份时会一并复制）
# LEDGER_SECRET_KEY=

# 数据连接单次同步的行数上限，默认 2000 万
# LEDGER_CONNECTOR_MAX_ROWS=20000000

# 对外开放的部署：拒绝服务器主动访问内网地址（网址导入、定时推送的 Webhook）；本机、云元数据地址一律拒绝
# LEDGER_URL_BLOCK_PRIVATE=1

# 会话 cookie 是否加 Secure：默认看可信反向代理传来的 X-Forwarded-Proto；明确指定用 1 / 0
# LEDGER_COOKIE_SECURE=1

# 删除的工作簿和数据集在回收站保留的天数，到期自动彻底删除（0 表示不自动清理）
# LEDGER_TRASH_DAYS=30

# 用户访问平台的地址：定时推送消息里的「查看完整看板」链接
# LEDGER_PUBLIC_URL=https://excel.example.com

# 定时推送的邮件发送（不设置时不能使用邮件渠道）
# LEDGER_SMTP_HOST=smtp.exmail.qq.com
# LEDGER_SMTP_PORT=465
# LEDGER_SMTP_USER=report@example.com
# LEDGER_SMTP_PASSWORD=
# LEDGER_SMTP_FROM=经营报表 <report@example.com>

# AI 分析助手：OpenAI 兼容、支持工具调用的模型接口（内网 vLLM / Ollama，或云端）
# LEDGER_AI_BASE_URL=http://vllm.internal:8000/v1
# LEDGER_AI_MODEL=qwen2.5-72b-instruct
# LEDGER_AI_API_KEY=

# 日志级别；LEDGER_LOG_FORMAT=json 时每行一个 JSON，便于日志系统采集
RUST_LOG=gridlake=info,tower_http=warn
# LEDGER_LOG_FORMAT=json
# 处理时间超过这个毫秒数的请求记入日志（默认 3000，0 关闭）
# LEDGER_SLOW_REQUEST_MS=3000
